{
  "mcpServers": {
    "fortigate-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/fortigate-mcp-server",
        "python",
        "-m",
        "src.fortigate_mcp.server"
      ],
      "env": {
        "FORTIGATE_MCP_CONFIG": "/path/to/fortigate-mcp-server/config/config.json"
      }
    },
    "FortiGateMCP": {
      "url": "http://127.0.0.1:8814/fortigate-mcp/",
      "transport": "http"
    }
  }
}
